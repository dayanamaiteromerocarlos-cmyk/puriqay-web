# Cabeceras de Cloudflare Pages.
# El service worker, index.html y el manifest se revalidan siempre: si quedaran en
# caché del navegador o del CDN, la app instalada no se enteraría de los despliegues.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json

# Los archivos de assets/ llevan hash en el nombre: nunca cambian.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
